{% macro news_card(event, category) -%}
<article class="news-card">
  <div class="card-media" style="--fallback:{{ category.color }}">
    {% set image_src = event.image_url if event.image_url else img_prefix + 'assets/images/placeholder-' + category.id + '.svg' %}
    <a href="{{ event.source_url }}" target="_blank" rel="noopener" aria-label="打开{{ event.title }}">
      <img src="{{ image_src }}" alt="{{ event.title }}" loading="lazy" onerror="this.closest('.card-media').classList.add('no-image')">
    </a>
  </div>
  <div class="card-body">
    <div class="card-meta">
      <span class="tag" style="--tag:{{ category.color }}">{{ category.name }}</span>
      <span class="source">{{ event.source_name }}{% if event.published_label %} · {{ event.published_label }}{% endif %}</span>
      {% if event.verification_count and event.verification_count >= 2 %}
      <span class="verified-badge" title="已由 {{ event.verified_by|join('、') }} 交叉验证">已核验 {{ event.verification_count }} 平台</span>
      {% endif %}
    </div>
    <h3><a href="{{ event.source_url }}" target="_blank" rel="noopener">{{ event.title }}</a></h3>
    <p class="card-summary">{{ event.summary }}</p>
    <details class="card-detail">
      <summary>展开详细解释</summary>
      <div class="detail-body">{{ event.detail }}</div>
      {% if event.tags %}
      <ul class="event-tags">
        {% for tag in event.tags %}<li>{{ tag }}</li>{% endfor %}
      </ul>
      {% endif %}
    </details>
    <div class="card-footer">
      <span class="importance">重要度 {{ event.importance }}</span>
      <a class="read-link" href="{{ event.source_url }}" target="_blank" rel="noopener">阅读原文 ↗</a>
    </div>
  </div>
</article>
{%- endmacro %}
