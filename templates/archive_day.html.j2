{% from "_cards.html.j2" import news_card with context %}
<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ display_date }} · {{ digest.site_title }}</title>
  <meta name="description" content="{{ digest.site_tagline }}">
  <link rel="stylesheet" href="../assets/style.css">
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' rx='14' fill='%23d92c20'/><text x='50' y='72' font-size='58' text-anchor='middle' fill='white' font-family='sans-serif'>闻</text></svg>">
</head>
<body>
  <header class="site-header">
    <div class="container topbar">
      <a class="brand" href="../index.html">{{ digest.site_title }}</a>
      <nav class="topnav" aria-label="主导航">
        <div class="day-menu">
          <details>
            <summary>今日 <span class="caret">▾</span></summary>
            <ul class="day-menu-list">
              {% for item in day_nav %}
              <li>
                {% if item.available %}
                <a href="{{ item.href }}"><strong>{{ item.label }}</strong><span>{{ item.date }}</span></a>
                {% else %}
                <span class="day-empty"><strong>{{ item.label }}</strong><span>{{ item.date }} · 暂无</span></span>
                {% endif %}
              </li>
              {% endfor %}
            </ul>
          </details>
        </div>
        <a href="index.html" class="active">归档</a>
      </nav>
    </div>
  </header>

  <main class="container">
    <section class="masthead">
      <p class="masthead-kicker">历史归档 · {{ display_date }}</p>
      <h1>{{ short_date }}热点早报</h1>
      <p class="masthead-meta">生成于 {{ generated_time }} · 聚合 {{ digest.feed_names|length }} 个信息源</p>
    </section>

    <nav class="archive-nav" aria-label="归档导航">
      {% if archive_prev %}<a href="{{ archive_prev.href }}">← {{ archive_prev.label }}</a>{% endif %}
      <a href="index.html">归档列表</a>
      {% if archive_next %}<a href="{{ archive_next.href }}">{{ archive_next.label }} →</a>{% endif %}
    </nav>

    {% for category in digest.categories %}
    <section class="category" id="cat-{{ category.id }}">
      <header class="category-header">
        <span class="category-dot" style="background:{{ category.color }}"></span>
        <div>
          <h2>{{ category.name }}</h2>
          {% if category.description %}<p>{{ category.description }}</p>{% endif %}
        </div>
        <span class="category-count">{{ category.events|length }} 条</span>
      </header>
      {% if category.events %}
      <div class="card-list">
        {% for event in category.events %}{{ news_card(event, category) }}{% endfor %}
      </div>
      {% else %}
      <p class="empty-note">当日暂无可用数据。</p>
      {% endif %}
    </section>
    {% endfor %}
  </main>

  <footer class="site-footer">
    <div class="container">
      <h2>数据来源</h2>
      <ul class="footer-sources">
        {% for feed in feeds %}<li>{{ feed.name }}</li>{% endfor %}
      </ul>
      <p>生成时间：{{ digest.generated_at }} · 本站仅对公开新闻做自动聚合与摘要，内容版权归原网站所有，点击“阅读原文”跳转原始网页。</p>
    </div>
  </footer>
</body>
</html>
